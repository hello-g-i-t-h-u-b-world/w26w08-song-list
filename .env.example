# =====================================================================
#  .env.example
#  어떤 환경변수가 필요한지를 알려주는 템플릿 파일
#
#  사용법:
#    1) 복사해서 .env.local 을 만든다 →  cp .env.example .env.local
#    2) .env.local 에 실제 값을 채움 (.gitignore에 추가하여 Git에 커밋하지 않음)
# =====================================================================

# Supabase Dashboard → Project Settings → API Keys → Project URL
VITE_SUPABASE_URL=https://abcdefghijk.supabase.co

# Supabase 공개 키 (Publishable key, sb_publishable_...)
# ⚠️ 레거시 anon key(eyJ...)는 2026년 말 deprecated 예정. publishable key 사용할 것
# Supabase Dashboard → Project Settings → API Keys → Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
#  ⚠️ Vite 규칙: 브라우저로 노출할 값은 반드시 VITE_ 접두사를 붙임
#     접두사가 없는 변수는 클라이언트 코드에서 import.meta.env.XXX 로 읽을 수 없음
#  ⚠️ import.meta.env.* 값은 빌드 시점에 문자열로 치환됨
#     Vercel에 배포할 때는 이 두 값이 빌드 환경변수로 반드시 등록되어 있어야 함
# ---------------------------------------------------------------------